<?xml version="1.0" encoding="utf-8"?>
<!--
  LightCraft MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build lightcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.pcraft` owned by LightCraft,
  and LightCraft offered under "Open with" for PSD/PSB and the image formats it reads (without
  taking over the user's default app for them). With `-d ModelsDir=...` the AI mask models and
  their licences go into a models folder beside the executables (models/README.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="LightCraft"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="229BB552-5EFD-479A-BA86-8CB6D926390C"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="LightCraft image editor" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of LightCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="LightcraftIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LightcraftIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/lightcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/lightcraft" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="LightCraft">
<?ifdef ModelsDir?>
        <Directory Id="ModelsFolder" Name="models">
          <Directory Id="ModelLicensesFolder" Name="licenses" />
        </Directory>
<?endif?>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="LightCraft" Level="1">
      <ComponentGroupRef Id="LightcraftFiles" />
<?ifdef ModelsDir?>
      <ComponentGroupRef Id="ModelFiles" />
<?endif?>
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="LightcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="LightcraftApp" Guid="8A1D3A39-F7C1-47B1-97AE-40C80BF82F4A">
        <File Id="LightcraftExe" Source="$(var.BinDir)\lightcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="LightCraft"
              Description="LightCraft image editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="LightcraftIcon" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\lightcraft.exe" Value="[#LightcraftExe]" Type="string" />
      </Component>

      <Component Id="LightcraftCli">
        <File Id="LightcraftCliExe" Source="$(var.BinDir)\lightcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
<?ifdef ModelsDir?>

  <Fragment>
    <ComponentGroup Id="ModelFiles">
      <Component Id="ModelObject" Directory="ModelsFolder">
        <File Id="ModelObjectFile" Source="$(var.ModelsDir)\object.safetensors" KeyPath="yes" />
      </Component>
      <Component Id="ModelSubject" Directory="ModelsFolder">
        <File Id="ModelSubjectFile" Source="$(var.ModelsDir)\subject.safetensors" KeyPath="yes" />
      </Component>
      <Component Id="ModelSky" Directory="ModelsFolder">
        <File Id="ModelSkyFile" Source="$(var.ModelsDir)\sky.safetensors" KeyPath="yes" />
      </Component>
      <Component Id="ModelReadme" Directory="ModelsFolder">
        <File Id="ModelReadmeFile" Source="$(var.ModelsDir)\README.md" KeyPath="yes" />
      </Component>
      <Component Id="ModelLicenseApache" Directory="ModelLicensesFolder">
        <File Id="ModelLicenseApacheFile" Source="$(var.ModelsDir)\licenses\Apache-2.0.txt" KeyPath="yes" />
      </Component>
      <Component Id="ModelLicenseSky" Directory="ModelLicensesFolder">
        <File Id="ModelLicenseSkyFile" Source="$(var.ModelsDir)\licenses\MIT-Sky-Segmentation.txt" KeyPath="yes" />
      </Component>
      <Component Id="ModelLicenseTinyVit" Directory="ModelLicensesFolder">
        <File Id="ModelLicenseTinyVitFile" Source="$(var.ModelsDir)\licenses\MIT-TinyViT.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
<?endif?>
</Wix>
